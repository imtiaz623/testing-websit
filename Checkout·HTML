<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Checkout | FreshDrop</title>
  <meta name="description" content="Complete your FreshDrop order with Cash on Delivery." />
  <meta name="theme-color" content="#1b4332" />
  <meta name="robots" content="noindex" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Cpath fill='%231B4332' d='M20 4C12 10 8 18 8 24a12 12 0 0 0 24 0c0-6-4-14-12-20Z'/%3E%3Cpath stroke='%23F8FAF6' stroke-width='2' stroke-linecap='round' d='M20 12v20'/%3E%3C/svg%3E" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="style.css" />
</head>
<body>

  <a href="#main-content" class="skip-link">Skip to main content</a>

  <header class="navbar" id="navbar">
    <div class="nav-inner">
      <a href="index.html" class="brand"><span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 40 40" width="28" height="28"><path d="M20 4C12 10 8 18 8 24a12 12 0 0 0 24 0c0-6-4-14-12-20Z" fill="currentColor"/><path d="M20 12v20" stroke="#F8FAF6" stroke-width="2" stroke-linecap="round"/></svg></span>FreshDrop</a>
      <div class="nav-right">
        <button class="icon-btn theme-toggle" id="themeToggle" aria-label="Toggle dark mode" aria-pressed="false">
          <svg class="icon-sun" width="19" height="19" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.8"/><path d="M12 2.5v2.2M12 19.3v2.2M4.2 4.2l1.6 1.6M18.2 18.2l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.2 19.8l1.6-1.6M18.2 5.8l1.6-1.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          <svg class="icon-moon" width="19" height="19" viewBox="0 0 24 24" fill="none"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
        </button>
        <a href="cart.html" class="btn btn-ghost">Back to cart</a>
      </div>
    </div>
  </header>

  <main id="main-content">
    <section class="checkout-page">
      <div class="section-inner">
        <span class="eyebrow-tag">Checkout</span>
        <h1 style="margin-bottom: 28px;">Complete your order</h1>

        <div id="checkoutEmptyState" class="cart-empty" hidden>
          <p style="margin-bottom: 20px;">Your cart is empty, so there's nothing to check out.</p>
          <a href="store.html" class="btn btn-primary">Browse the Store</a>
        </div>

        <div id="checkoutFormState">
          <div class="checkout-layout">
            <div class="checkout-form-panel">
              <h2>Customer Information</h2>
              <form id="checkoutForm" novalidate>
                <div class="checkout-form-grid">
                  <div class="form-row full">
                    <label for="checkoutName">Full Name</label>
                    <input type="text" id="checkoutName" placeholder="Your full name" required />
                  </div>
                  <div class="form-row">
                    <label for="checkoutMobile">Mobile Number</label>
                    <input type="tel" id="checkoutMobile" placeholder="03XX-XXXXXXX" required />
                  </div>
                  <div class="form-row">
                    <label for="checkoutEmail">Email (optional)</label>
                    <input type="email" id="checkoutEmail" placeholder="you@example.com" />
                  </div>
                </div>

                <h2>Delivery Information</h2>
                <div class="checkout-form-grid">
                  <div class="form-row">
                    <label for="checkoutCity">City</label>
                    <input type="text" id="checkoutCity" placeholder="e.g. Lahore" required />
                  </div>
                  <div class="form-row">
                    <label for="checkoutArea">Area</label>
                    <input type="text" id="checkoutArea" placeholder="e.g. Gulberg" required />
                  </div>
                  <div class="form-row full">
                    <label for="checkoutAddress">Complete Address</label>
                    <textarea id="checkoutAddress" rows="3" placeholder="House #, street, block, etc." required></textarea>
                  </div>
                  <div class="form-row full">
                    <label for="checkoutLandmark">Nearest Landmark (optional)</label>
                    <input type="text" id="checkoutLandmark" placeholder="e.g. Near Al-Fateh, Main Boulevard" />
                  </div>
                </div>

                <h2>Payment Method</h2>
                <div class="payment-option">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="2" y="6" width="20" height="13" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M2 10h20" stroke="currentColor" stroke-width="1.8"/></svg>
                  Cash on Delivery (COD)
                </div>

                <button type="submit" class="btn btn-primary btn-block" style="margin-top: 26px;">Place Order</button>
              </form>
            </div>

            <div class="cart-summary">
              <h2>Order Summary</h2>
              <div class="order-summary-mini" id="checkoutItemsSummary"></div>
              <div class="cart-summary-row"><span>Subtotal</span><span id="checkoutSubtotal"></span></div>
              <div class="cart-summary-row"><span>Delivery charges</span><span id="checkoutDelivery"></span></div>
              <div class="cart-summary-row total"><span>Total</span><span id="checkoutTotal"></span></div>
            </div>
          </div>
        </div>

        <div id="orderConfirmationState" hidden style="max-width: 560px; margin: 0 auto; text-align: center; padding: 40px 0;">
          <div class="popup-icon" style="width: 64px; height: 64px; font-size: 1.8rem;">&#10003;</div>
          <h2 style="margin-bottom: 10px;">Order placed successfully!</h2>
          <p style="color: var(--muted); margin-bottom: 6px;">Your order ID is</p>
          <p class="order-id-display" id="confirmedOrderId"></p>
          <p style="color: var(--muted); font-size: 0.92rem; margin-bottom: 28px;">We'll call you at the number provided to confirm delivery details. Save your order ID to track your delivery.</p>
          <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
            <a href="index.html#track" class="btn btn-primary">Track this order</a>
            <a href="store.html" class="btn btn-ghost">Continue Shopping</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer" id="footer">
    <div class="section-inner footer-inner">
      <div><a href="index.html" class="brand footer-brand"><span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 40 40" width="26" height="26"><path d="M20 4C12 10 8 18 8 24a12 12 0 0 0 24 0c0-6-4-14-12-20Z" fill="currentColor"/><path d="M20 12v20" stroke="#1B4332" stroke-width="2" stroke-linecap="round"/></svg></span>FreshDrop</a></div>
      <div class="footer-links"><h4>Legal</h4><a href="privacy.html">Privacy Policy</a><a href="terms.html">Terms &amp; Conditions</a></div>
    </div>
    <p class="footer-bottom">&#169; 2026 FreshDrop. All rights reserved.</p>
  </footer>

  <div class="toast-container" id="toastContainer" aria-live="polite"></div>

  <script src="products-data.js"></script>
  <script src="cart.js"></script>
  <script src="wishlist.js"></script>
  <script src="orders-store.js"></script>
  <script src="script.js"></script>
  <script src="checkout.js"></script>
</body>
</html>
