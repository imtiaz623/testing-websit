        </a>
        <button class="icon-btn theme-toggle" id="themeToggle" aria-label="Toggle dark mode" aria-pressed="false">
          <svg class="icon-sun" width="19" height="19" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.8"/><path d="M12 2.5v2.2M12 19.3v2.2M4.2 4.2l1.6 1.6M18.2 18.2l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.2 19.8l1.6-1.6M18.2 5.8l1.6-1.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          <svg class="icon-moon" width="19" height="19" viewBox="0 0 24 24" fill="none"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
        </button>
        <button class="hamburger" id="hamburger" aria-label="Toggle menu" aria-expanded="false" aria-controls="navLinks">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </header>

  <div class="mobile-search-bar" id="mobileSearchBar" hidden>
    <div class="section-inner">
      <form id="mobileSearchForm" novalidate>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8"/><path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        <input type="text" id="mobileSearchInput" placeholder="Search products..." aria-label="Search products" />
      </form>
    </div>
  </div>

  <main id="main-content">
    <section class="store-header">
      <div class="section-inner">
        <span class="eyebrow-tag">Marketplace</span>
        <h1>Shop all products</h1>
        <p class="section-lead" style="margin-bottom: 0;">Electronics, fashion, beauty, home &amp; kitchen, and more &#8212; delivered nationwide with cash on delivery.</p>
      </div>
    </section>

    <section class="store-layout">
      <div class="section-inner">
        <div class="store-grid-wrap">

          <aside class="filter-sidebar" id="filterSidebar" aria-label="Filter products">
            <div class="filter-group">
              <h3>Category</h3>
              <div id="categoryFilterList"><!-- populated by store.js --></div>
            </div>

            <div class="filter-group">
              <h3>Price range (Rs.)</h3>
              <div class="filter-price-inputs">
                <input type="number" id="priceMin" placeholder="Min" min="0" />
                <span>&#8211;</span>
                <input type="number" id="priceMax" placeholder="Max" min="0" />
              </div>
            </div>

            <div class="filter-group">
              <h3>Minimum rating</h3>
              <label class="filter-option"><input type="radio" name="ratingFilter" value="0" checked /> Any rating</label>
              <label class="filter-option"><input type="radio" name="ratingFilter" value="4.5" /> 4.5 &amp; up</label>
              <label class="filter-option"><input type="radio" name="ratingFilter" value="4" /> 4.0 &amp; up</label>
              <label class="filter-option"><input type="radio" name="ratingFilter" value="3.5" /> 3.5 &amp; up</label>
            </div>

            <div class="filter-group">
              <h3>Availability</h3>
              <label class="filter-option"><input type="checkbox" id="inStockOnly" /> In stock only</label>
            </div>

            <div class="filter-group">
              <h3>Brand</h3>
              <div id="brandFilterList"><!-- populated by store.js --></div>
            </div>

            <button class="btn btn-ghost filter-clear-btn" id="clearFiltersBtn" type="button">Clear filters</button>
          </aside>

          <div class="store-main">
            <button class="btn btn-ghost mobile-filter-toggle" id="mobileFilterToggle" type="button">Filters</button>

            <div class="store-toolbar">
              <p class="store-count" id="storeCount">Showing products</p>
              <div class="sort-dropdown">
                <label for="sortSelect" class="visually-hidden">Sort by</label>
                <select id="sortSelect">
                  <option value="popular">Sort: Popular</option>
                  <option value="newest">Sort: Newest</option>
                  <option value="price-low">Price: Low to High</option>
                  <option value="price-high">Price: High to Low</option>
                  <option value="rating">Sort: Rating</option>
                </select>
              </div>
            </div>

            <div class="store-product-grid" id="storeProductGrid"><!-- populated by store.js --></div>

            <div class="load-more-wrap" id="loadMoreWrap" hidden>
              <button class="btn btn-ghost" id="loadMoreBtn" type="button">Load more products</button>
            </div>
          </div>

        </div>
      </div>
    </section>
  </main>

  <nav class="mobile-bottom-nav" aria-label="Mobile navigation">
    <div class="mobile-bottom-nav-inner">
      <a href="index.html" class="bottom-nav-item">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 11 12 4l8 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M6 10v9a1 1 0 0 0 1 1h4v-6h2v6h4a1 1 0 0 0 1-1v-9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Home
