          <svg viewBox="0 0 40 40" width="28" height="28"><path d="M20 4C12 10 8 18 8 24a12 12 0 0 0 24 0c0-6-4-14-12-20Z" fill="currentColor"/><path d="M20 12v20" stroke="#F8FAF6" stroke-width="2" stroke-linecap="round"/></svg>
