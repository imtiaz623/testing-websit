/* Build the public product list: only customer-facing fields are exposed
   through this array's shape, even though the raw objects still carry the
   internal supplier fields above (kept for the future admin layer). UI
   code should read PRODUCTS, not RAW_PRODUCTS, and should never render
   .supplierPrice / .supplierSKU / .profitMarginPercent. */
const PRODUCTS = RAW_PRODUCTS.map(function (p) {
  const sellingPrice = computeSellingPrice(p.supplierPrice, p.profitMarginPercent);
  const originalPrice = computeOriginalPrice(sellingPrice, p.discountPercent);
  return Object.assign({}, p, {
    sellingPrice: sellingPrice,
    originalPrice: originalPrice,
    inStock: p.stock > 0,
    status: p.stock > 0 ? "active" : "out-of-stock"
  });
});

function getProductBySlug(slug) {
  return PRODUCTS.find(function (p) { return p.slug === slug; }) || null;
}

function getProductsByCategory(categoryId) {
  return PRODUCTS.filter(function (p) { return p.category === categoryId; });
}

function getRelatedProducts(product, limit) {
  return PRODUCTS.filter(function (p) {
    return p.category === product.category && p.productId !== product.productId;
  }).slice(0, limit || 4);
}

function formatPKR(amount) {
  return "Rs. " + Math.round(amount).toLocaleString("en-PK");
}

/* ==========================================================================
   Optional Firestore sync (progressive enhancement)
   --------------------------------------------------------------------------
   If firebase-config.js has been set up with real project credentials, this
   pulls the live product catalog from Firestore's "products" collection and
   replaces the contents of PRODUCTS in place, then calls onReady() so the
   page can re-render. If Firebase isn't configured, or the fetch fails, or
   the "products" collection is empty, PRODUCTS simply keeps using the local
   RAW_PRODUCTS catalog above -- nothing on the page breaks either way.
   ========================================================================== */

function buildComputedProduct(raw) {
  const sellingPrice = raw.sellingPriceOverride || computeSellingPrice(raw.supplierPrice, raw.profitMarginPercent);
  const originalPrice = computeOriginalPrice(sellingPrice, raw.discountPercent);
  return Object.assign({}, raw, {
    sellingPrice: sellingPrice,
    originalPrice: originalPrice,
    inStock: raw.stock > 0,
    status: raw.stock > 0 ? "active" : "out-of-stock"
  });
}

function syncProductsFromFirestore(onReady) {
  if (typeof FIREBASE_ENABLED === "undefined" || !FIREBASE_ENABLED || !firebaseDb) return;

  firebaseDb.collection("products").get().then(function (snapshot) {
    if (snapshot.empty) return; /* no products added in Firestore yet -- keep local catalog */

    const fetched = [];
    snapshot.forEach(function (doc) {
      fetched.push(buildComputedProduct(Object.assign({ productId: doc.id }, doc.data())));
    });

    PRODUCTS.length = 0;
    fetched.forEach(function (p) { PRODUCTS.push(p); });

    if (typeof onReady === "function") onReady();
  }).catch(function (err) {
    console.warn("Could not load products from Firestore, using local catalog.", err);
  });
}
