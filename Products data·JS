/* ==========================================================================
   FreshDrop Marketplace -- Product data layer
   --------------------------------------------------------------------------
   This is the single source of product data for the whole site (store page,
   homepage sections, product detail page, cart, search). Nothing hardcodes
   product info directly into UI components -- everything reads from here.

   IMPORTANT -- supplier/margin fields are considered INTERNAL/ADMIN-ONLY:
   supplierSKU, supplierPrice, profitMarginPercent, supplier.
   No UI component should ever render these to a customer. Only
   sellingPrice, originalPrice (derived), and discountPercent are customer
   facing. This keeps the data model ready for a future supplier/admin
   panel (CSV import, API feed, dropshipping integration) without any
   frontend rebuild -- the UI already only reads the public fields below.
   ========================================================================== */

/**
 * Computes a selling price from a supplier cost and a profit margin.
 * Example: supplierPrice 1000, margin 30% -> sellingPrice 1300.
 * An admin panel could call this to auto-price new supplier feed items,
 * or override the result manually per product.
 */
function computeSellingPrice(supplierPrice, profitMarginPercent) {
  return Math.round(supplierPrice * (1 + profitMarginPercent / 100));
}

/**
 * Derives a "was" price from a selling price + discount percent, so the
 * UI can show a struck-through original price next to the current price.
 */
function computeOriginalPrice(sellingPrice, discountPercent) {
  if (!discountPercent) return null;
  return Math.round(sellingPrice / (1 - discountPercent / 100));
}

