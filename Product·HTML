      <a href="store.html" class="bottom-nav-item active"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 8h16l-1.2 10.2a2 2 0 0 1-2 1.8H7.2a2 2 0 0 1-2-1.8L4 8Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8 8V6a4 4 0 0 1 8 0v2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>Store</a>
      <a href="store.html?deal=1" class="bottom-nav-item"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 12 12.6 4.6a2 2 0 0 0-1.4-.6H5a1 1 0 0 0-1 1v6.2c0 .5.2 1 .6 1.4L12 20l8-8Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="8.5" cy="8.5" r="1.3" fill="currentColor"/></svg>Deals</a>
      <a href="cart.html" class="bottom-nav-item"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 4h2l2.4 12.4a2 2 0 0 0 2 1.6h8.2a2 2 0 0 0 2-1.6L21 8H6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9.5" cy="20.5" r="1.3" fill="currentColor"/><circle cx="17.5" cy="20.5" r="1.3" fill="currentColor"/></svg>Cart<span class="bottom-nav-badge hidden" data-cart-count>0</span></a>
      <a href="account.html" class="bottom-nav-item"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="8" r="3.5" stroke="currentColor" stroke-width="1.8"/><path d="M5 20c1.2-3.8 4.2-6 7-6s5.8 2.2 7 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>Account</a>
    </div>
  </nav>

  <footer class="site-footer" id="footer">
    <div class="section-inner footer-inner">
      <div>
        <a href="index.html" class="brand footer-brand"><span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 40 40" width="26" height="26"><path d="M20 4C12 10 8 18 8 24a12 12 0 0 0 24 0c0-6-4-14-12-20Z" fill="currentColor"/><path d="M20 12v20" stroke="#1B4332" stroke-width="2" stroke-linecap="round"/></svg></span>FreshDrop</a>
        <p class="footer-tagline">Online shopping, delivered nationwide.</p>
      </div>
      <div class="footer-links"><h4>Explore</h4><a href="store.html">Store</a><a href="index.html#track">Track order</a><a href="index.html#faq">FAQ</a></div>
      <div class="footer-links"><h4>Legal</h4><a href="privacy.html">Privacy Policy</a><a href="terms.html">Terms &amp; Conditions</a></div>
    </div>
    <p class="footer-bottom">&#169; 2026 FreshDrop. All rights reserved.</p>
  </footer>

  <div class="toast-container" id="toastContainer" aria-live="polite"></div>

  <script src="products-data.js"></script>
  <script src="cart.js"></script>
  <script src="wishlist.js"></script>
  <script src="marketplace-ui.js"></script>
  <script src="script.js"></script>
  <script src="product.js"></script>
</body>
</html>
